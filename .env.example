# Que는 dotenv를 자동으로 읽지 않는다.
# 이 파일은 config.py가 os.environ에서 읽는 키의 목록이다.
# 쓰려면 셸에서 export 하거나, `set -a; source .env; set +a` 후 프로세스를 띄운다.
# 값을 채운 파일은 커밋하지 말 것(.gitignore의 *.env).

# 로컬 listen 주소와 백엔드 포트.
QUE_HOST=127.0.0.1
QUE_PORT=8788

# Ingest 허용 경로. 빈 값이면 그 타깃은 비활성.
# QUE_INGEST_INBOX 기본값은 ~/QueInbox. 서버 기동 시 폴더를 만든다.
# 나머지 둘은 기본 비활성. 전부 비우면 ingest는 꺼지고 ensure_inbox는 no-op.
QUE_INGEST_INBOX=~/QueInbox
QUE_INGEST_MEMEX_RAW_DROPBOX=
QUE_INGEST_FLYWHEEL_RAW=

# 외부 API Bearer 토큰. 없으면 /api/v1 은 503으로 비활성화된다.
QUE_API_TOKEN=
